diff --git a/bsp/abstract-machine/extra-soc.ld b/bsp/abstract-machine/extra-soc.ld
new file mode 100644
index 0000000..d268f65
--- /dev/null
+++ b/bsp/abstract-machine/extra-soc.ld
@@ -0,0 +1,50 @@
+SECTIONS {
+  .data.extra ADDR(.rodata) + SIZEOF(.rodata) :
+      AT(LOADADDR(.rodata) + SIZEOF(.rodata)) {
+    /* section information for finsh shell */
+    __fsymtab_start = .;
+    KEEP(*(FSymTab))
+    __fsymtab_end = .;
+    . = ALIGN(8);
+    __vsymtab_start = .;
+    KEEP(*(VSymTab))
+    __vsymtab_end = .;
+    . = ALIGN(8);
+
+    /* section information for initial. */
+    . = ALIGN(8);
+    __rt_init_start = .;
+    KEEP(*(SORT(.rti_fn*)))
+    __rt_init_end = .;
+    . = ALIGN(8);
+
+    __rt_utest_tc_tab_start = .;
+    KEEP(*(UtestTcTab))
+    __rt_utest_tc_tab_end = .;
+
+    . = ALIGN(8);
+    __am_apps_data_start = .;
+    *(__am_apps.data*)
+    *(__am_apps.sdata*)
+    __am_apps_data_end = .;
+    . = ALIGN(8);
+  }
+  _data_extra_vma_end = ADDR(.data.extra) + SIZEOF(.data.extra);
+  _data_extra_load_end = LOADADDR(.data.extra) + SIZEOF(.data.extra);
+}
+INSERT BEFORE .data;
+
+SECTIONS {
+  .bss.extra ADDR(.data) + SIZEOF(.data) (NOLOAD) : {
+    . = ALIGN(8);
+    __am_apps_bss_start = .;
+    *(__am_apps.bss*)
+    *(__am_apps.sbss*)
+    *(__am_apps.scommon*)
+    __am_apps_bss_end = .;
+    . = ALIGN(8);
+  }
+  _bss_extra_start = ADDR(.bss.extra);
+  _bss_extra_vma_end = ADDR(.bss.extra) + SIZEOF(.bss.extra);
+}
+INSERT BEFORE .bss;

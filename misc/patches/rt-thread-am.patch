diff --git a/bsp/abstract-machine/src/context.c b/bsp/abstract-machine/src/context.c
index ee38829..5b02da5 100644
--- a/bsp/abstract-machine/src/context.c
+++ b/bsp/abstract-machine/src/context.c
@@ -5 +5,30 @@
-static Context* ev_handler(Event e, Context *c) {
+/* =======================
+ * 线程上下文切换参数
+ * ======================= */
+typedef struct {
+  rt_ubase_t to;
+  rt_ubase_t from;
+} ctx_switch_ud_t;
+
+/* =======================
+ * 线程入口参数
+ * ======================= */
+typedef struct {
+  void (*tentry)(void*);
+  void* parameter;
+  void (*texit)(void);
+} thread_args_t;
+
+/* =======================
+ * 线程启动包装
+ * ======================= */
+static void context_wrapper(thread_args_t* args) {
+  args->tentry(args->parameter);
+  args->texit();
+  while (1);  // 不应返回
+}
+
+/* =======================
+ * AM 事件处理
+ * ======================= */
+static Context* ev_handler(Event e, Context* c) {
@@ -7 +36,14 @@ static Context* ev_handler(Event e, Context *c) {
-    default: printf("Unhandled event ID = %d\n", e.event); assert(0);
+    case EVENT_YIELD: {
+      rt_thread_t current = rt_thread_self();
+      ctx_switch_ud_t *ud = (ctx_switch_ud_t *)current->user_data;
+      if (ud->from) *((Context**)ud->from) = c;
+      c = *(Context**)ud->to;
+      break;
+    }
+    case EVENT_IRQ_TIMER:
+      return c;
+    case EVENT_IRQ_IODEV:
+      return c;
+    default:
+      printf("Unhandled event ID = %d\n", e.event);
+      assert(0);
@@ -11,0 +54,3 @@ static Context* ev_handler(Event e, Context *c) {
+/* =======================
+ * CTE 初始化
